<?xml version="1.0" encoding="utf-8"?>
<!--
  DEFERRED sandbox HUD — not wired to ToolkitExamples/Idle/*_Slice.prefab.
  Live idle MVP path: IdleSliceUIController (Actions + Cosmetics tabs).
  To use this asset: assign as UIDocument sourceAsset and add IdleGameHudBinder.
  UI3-05: GoldLabel currently mirrors CurrentRunStats (runner-shaped). Before revival,
  switch primary/prestige labels to IdleSliceState — do not wire binder until then.
-->
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="IdleGameHUD.uss" />
    <ui:VisualElement class="idle-hud-root">

        <ui:Label text="Idle Sandbox HUD" class="idle-hud-title"/>

        <ui:VisualElement class="idle-hud-currency-row">
            <ui:Label text="Gold: 0" name="GoldLabel" class="idle-hud-gold"/>
            <ui:Label text="Prestige: 0" name="PrestigeLabel" class="idle-hud-prestige"/>
        </ui:VisualElement>

        <ui:VisualElement class="idle-hud-tab-row">
            <ui:Button text="Upgrades" name="UpgradesTabButton" class="idle-hud-tab idle-hud-tab-left"/>
            <ui:Button text="Cosmetics" name="CosmeticsTabButton" class="idle-hud-tab idle-hud-tab-right"/>
        </ui:VisualElement>

        <ui:VisualElement name="UpgradesContainer" class="idle-hud-upgrades">
            <ui:Button text="BUY UPGRADE (Cost: 50 Gold)" name="BuyUpgradeButton" class="idle-hud-buy"/>
            <ui:Button text="ASCEND (Prestige)" name="PrestigeButton" class="idle-hud-ascend"/>
        </ui:VisualElement>

        <ui:VisualElement name="CosmeticsContainer" class="idle-hud-cosmetics">
            <ui:ScrollView name="CosmeticsScrollView" class="idle-hud-cosmetics-scroll">
                <ui:VisualElement class="idle-hud-skin-row">
                    <ui:Label text="Classic Blue (Default)" class="idle-hud-skin-label"/>
                    <ui:Button text="EQUIP" name="EquipSkin0Button" class="idle-hud-skin-btn idle-hud-skin-btn-0"/>
                </ui:VisualElement>
                <ui:VisualElement class="idle-hud-skin-row">
                    <ui:Label text="Crimson Red (Cost: 5 Prestige)" class="idle-hud-skin-label"/>
                    <ui:Button text="BUY (5 P)" name="BuySkin1Button" class="idle-hud-skin-btn idle-hud-skin-btn-1"/>
                </ui:VisualElement>
                <ui:VisualElement class="idle-hud-skin-row">
                    <ui:Label text="Solid Gold (Cost: 15 Prestige)" class="idle-hud-skin-label"/>
                    <ui:Button text="BUY (15 P)" name="BuySkin2Button" class="idle-hud-skin-btn idle-hud-skin-btn-2"/>
                </ui:VisualElement>
                <ui:VisualElement class="idle-hud-skin-row">
                    <ui:Label text="Emerald Neon (Cost: 30 Prestige)" class="idle-hud-skin-label"/>
                    <ui:Button text="BUY (30 P)" name="BuySkin3Button" class="idle-hud-skin-btn idle-hud-skin-btn-3"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
