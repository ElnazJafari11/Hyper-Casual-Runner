.victory-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.victory-card {
    width: 85%;
    max-width: 420px;
    background-color: #121829;
    border-radius: 20px;
    padding: 25px;
    align-items: center;
}

.victory-title {
    font-size: 34px;
    color: #FFD700;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.victory-stars-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 15px;
}

.vic-star {
    font-size: 40px;
    margin-left: 5px;
    margin-right: 5px;
}

.vic-star-active {
    color: #FFD700;
}

.vic-star-inactive {
    color: #444444;
}

.coins-earned-label {
    font-size: 22px;
    color: #FFFFFF;
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.multiplier-container {
    width: 100%;
    background-color: #1E293B;
    border-radius: 12px;
    padding: 12px;
    align-items: center;
    margin-bottom: 20px;
}

.multiplier-label {
    font-size: 24px;
    color: #38BDF8;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.ticker-track {
    width: 100%;
    height: 14px;
    background-color: #0F172A;
    border-radius: 7px;
    overflow: hidden;
}

.ticker-bar {
    width: 20px;
    height: 100%;
    background-color: #F59E0B;
    border-radius: 7px;
}

.claim-btn {
    width: 100%;
    height: 55px;
    font-size: 20px;
    background-color: #22C55E;
    color: #FFFFFF;
    border-radius: 12px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.ad-btn {
    width: 100%;
    height: 50px;
    font-size: 18px;
    background-color: #3B82F6;
    color: #FFFFFF;
    border-radius: 12px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.next-btn {
    width: 100%;
    height: 50px;
    font-size: 18px;
    background-color: #64748B;
    color: #FFFFFF;
    border-radius: 12px;
    -unity-font-style: bold;
}
